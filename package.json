{
  "name": "hermes-assistant",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "bun run --filter @hermes/api dev",
    "dev:web": "bun run --filter @hermes/web dev",
    "start:api": "bun run --filter @hermes/api start",
    "db:migrate": "bun run --filter @hermes/api db:migrate",
    "db:status": "bun run --filter @hermes/api db:status",
    "db:rollback": "bun run --filter @hermes/api db:rollback",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "organize-imports": "biome check --write --formatter-enabled=false --linter-enabled=false .",
    "check": "biome check .",
    "fix": "biome check --write .",
    "typecheck": "bun run --filter @hermes/api typecheck && bun run --filter @hermes/web typecheck",
    "test": "bun run --filter @hermes/api test && bun run --filter @hermes/web test",
    "test:integration": "bun run --filter @hermes/api test:integration",
    "verify": "bun run check && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12"
  }
}
