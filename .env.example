# Runtime settings.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=debug
READINESS_TIMEOUT_MS=2000

# PostgreSQL connection string for local development.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hermes

# Internal credential used by the Hermes Agent to call the API. Use at least 32 characters.
INTERNAL_API_KEY=replace-with-a-long-random-secret

# Static browser password hash. Generate with Bun.password.hash using argon2id; no real password belongs here.
# In Bun dotenv files, escape every literal $ as \$ even inside quotes; quoting alone does not stop expansion.
WEB_AUTH_PASSWORD_HASH='replace-with-a-generated-argon2id-hash'
# Generate with: bun -e 'console.log(require("node:crypto").randomBytes(32).toString("hex"))'
WEB_AUTH_JWT_SECRET=replace-with-64-random-hex-characters
# Development accepts localhost or 127.0.0.1 on this port. Staging/production require the exact HTTPS origin.
WEB_AUTH_ORIGIN=http://127.0.0.1:5173

# Optional web AI-assisted capture. Set all three values together to enable it;
# leave them unset to keep the AI path disabled. Never use a VITE_ prefix.
# The AI-derived Junk item is inserted immediately, like the Telegram flow.
# The base URL must include the provider API version, for example:
#   OpenCode:   https://opencode.ai/inference/openai/v1   (key: https://opencode.ai/auth)
#   DeepSeek:   https://api.deepseek.com/v1
#   OpenAI:     https://api.openai.com/v1
#   OpenRouter: https://openrouter.ai/api/v1
# The model must support OpenAI-compatible JSON mode and accept temperature.
# OpenCode free models (…-free) only work inside the OpenCode client; use a paid model here.
# AI_BASE_URL=https://opencode.ai/inference/openai/v1
# AI_API_KEY=
# AI_MODEL=deepseek-v4.1-flash
# AI_MAX_TOKENS=4096
# AI_TEMPERATURE=0
# AI_TIMEOUT_MS=30000

# Local Vite development proxy target. Browser requests use their HttpOnly auth cookie.
API_PROXY_TARGET=http://127.0.0.1:3000
