# Runtime settings.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=debug
READINESS_TIMEOUT_MS=2000

# PostgreSQL connection string for local development.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hermes

# Internal credential used by the Hermes Agent to call the API. Use at least 32 characters.
INTERNAL_API_KEY=replace-with-a-long-random-secret

# Static browser password hash. Generate with Bun.password.hash using argon2id; no real password belongs here.
# In Bun dotenv files, escape every literal $ as \$ even inside quotes; quoting alone does not stop expansion.
WEB_AUTH_PASSWORD_HASH='replace-with-a-generated-argon2id-hash'
# Generate with: bun -e 'console.log(require("node:crypto").randomBytes(32).toString("hex"))'
WEB_AUTH_JWT_SECRET=replace-with-64-random-hex-characters
# Development may use a loopback HTTP origin. Staging/production require the exact HTTPS frontend origin.
WEB_AUTH_ORIGIN=http://127.0.0.1:5173

# Local Vite development proxy target. This value and INTERNAL_API_KEY remain server-side.
API_PROXY_TARGET=http://127.0.0.1:3000
