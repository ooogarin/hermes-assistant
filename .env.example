# Runtime settings.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=debug
READINESS_TIMEOUT_MS=2000

# PostgreSQL connection string for local development.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hermes

# Internal credential used by the Hermes Agent to call the API. Use at least 32 characters.
INTERNAL_API_KEY=replace-with-a-long-random-secret

# Local Vite development proxy target. This value and INTERNAL_API_KEY remain server-side.
API_PROXY_TARGET=http://127.0.0.1:3000
